    {
      "id": "EX-0103",
      "category": "obedience",
      "difficulty": "medium",
      "duration": 20,
      "learners": 18,
      "title": "Dừng hành vi kéo căng dây dắt (Loose Leash Walking)",
      "desc": "Kỹ thuật \"Cây đóng băng\" (Be a Tree): Dừng bước ngay khi dây dắt bị kéo căng và chỉ bước tiếp khi thú cưng quay lại nhìn người dẫn hoặc chùng dây.",
      "props": "Dây dắt yếm ngực chống kéo + Bánh thưởng",
      "propKeys": [
        "treat",
        "harness"
      ],
      "steps": [
        {
          "t": "Bước 1: Làm quen vị trí bên hông (Inside Zone)",
          "d": "Đứng yên tại phòng kín. Thưởng bánh ngay khi cún chủ động bước lại đứng cạnh đùi người dẫn mà không bị giật dây."
        },
        {
          "t": "Bước 2: Áp dụng kỹ thuật \"Cây đóng băng\" (Be a Tree)",
          "d": "Ngay thời khắc dây căng ra, HLV dừng bước tuyệt đối. Không giật dây, không la mắng. Chờ cún quay đầu lại nhìn."
        },
        {
          "t": "Bước 3: Hiệu lệnh \"Bước cùng nào\"",
          "d": "Khi dây chùng hình chữ U, bấm Clicker hoặc nói \"Tốt\", thưởng ngang đùi và bước tiếp 3-5 bước."
        },
        {
          "t": "Bước 4: Tăng xao nhãng & ra thực địa",
          "d": "Dẫn cún ra khu vườn hoặc nơi có người qua lại. Lặp lại bước 2 mỗi khi lực kéo xuất hiện."
        }
      ],
      "mistakes": [
        "Kéo ngược dây kiểu \"kéo co\" khiến cún chống đối.",
        "Dùng dây tự cuộn (Flexi leash) tạo lực căng liên tục.",
        "Thưởng bánh khi cún đang chồm lên người dẫn."
      ],
      "criteria": [
        "Dây dắt hình chữ U tối thiểu 30m đi bộ liên tục",
        "Cún chủ động nhìn người dẫn ≥ 3 lần/phút",
        "Dừng đúng nhịp chân của chủ"
      ],
      "img": "https://lh3.googleusercontent.com/aida-public/AB6AXuC9VoVh8NULP4ylablFi6iYez-vxOcn5unxP0rDGJeD9E_acO-DhnjaIGGU2nX_FNHv6wnW8IplkXJelOQtO75ZhWxC_gIMbc27QIQuK9kvqMa0uBa2lFxBSXDk1UqzQFgQpFCdfdTubf1Gzx06uw_UD58h98Xaim23KLcdgjDAdvZRm6lLBVEn2DLT7AsKO0cj7XODy5CBVZ5O6H06CJpSKZsRp06-2ixxoBzRfbrtuClikhUnApPV",
      "archived": false,
      "updatedAt": "2025-05-11T08:00:00"
    },
    {
      "id": "EX-0104",
      "category": "behavior",
      "difficulty": "easy",
      "duration": 15,
      "learners": 31,
      "title": "Không chồm lên người khi mừng chủ về (No Jumping Greeting)",
      "desc": "Huấn luyện quy tắc \"Bốn chân chạm đất\" (Four on the Floor). Chỉ khi cún giữ chân dưới sàn mới được vuốt ve và đáp lại niềm vui chào đón.",
      "props": "Đồ ăn thưởng + Khu vực cửa ra vào",
      "propKeys": [
        "treat"
      ],
      "steps": [
        {
          "t": "Bước 1: Quay lưng khi cún chồm",
          "d": "Không nhìn, không nói, quay lưng ngay khi cún nhảy lên."
        },
        {
          "t": "Bước 2: Thưởng khi 4 chân chạm đất",
          "d": "Chào hỏi và thưởng ngay lúc cún đứng yên."
        },
        {
          "t": "Bước 3: Thêm khách lạ",
          "d": "Nhờ người quen lặp lại quy tắc ở cửa ra vào."
        }
      ],
      "mistakes": [
        "Hét \"Xuống!\" làm cún tưởng được chú ý.",
        "Chỉ tập khi có khách, không tập hằng ngày."
      ],
      "criteria": [
        "4 chân chạm sàn khi chào chủ",
        "Không chồm khi có khách lạ"
      ],
