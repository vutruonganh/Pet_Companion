  "exercises": [
    {
      "id": "EX-0102",
      "category": "obedience",
      "difficulty": "easy",
      "duration": 10,
      "learners": 24,
      "title": "Lệnh Ngồi & Giữ vị trí (Sit & Stay Duration)",
      "desc": "Dạy thú cưng ngồi yên tại chỗ trong ít nhất 45 giây trước khi nhận hiệu lệnh giải phóng \"OK\". Tăng cường khả năng tự chủ và tập trung cao độ.",
      "props": "Bánh thưởng mềm + Clicker âm thanh",
      "propKeys": [
        "treat",
        "clicker"
      ],
      "steps": [
        {
          "t": "Bước 1: Ngồi 3 giây",
          "d": "Ra lệnh Ngồi, thưởng khi cún giữ yên 3 giây."
        },
        {
          "t": "Bước 2: Tăng thời gian",
          "d": "Tăng dần 5 → 15 → 30 giây, thưởng liên tục."
        },
        {
          "t": "Bước 3: Thêm khoảng cách",
          "d": "Lùi 1 bước rồi quay lại thưởng."
        },
        {
          "t": "Bước 4: Hiệu lệnh giải phóng",
          "d": "Nói \"OK\" để kết thúc bài."
        }
      ],
      "mistakes": [
        "Thưởng khi cún đã đứng dậy.",
        "Lặp lệnh nhiều lần liên tục."
      ],
      "criteria": [
        "Giữ vị trí tối thiểu 45 giây",
        "Không đứng dậy trước lệnh \"OK\"",
        "Nhìn người dẫn khi được gọi tên"
      ],
      "img": "https://lh3.googleusercontent.com/aida-public/AB6AXuB2eftqRKj9eSmmzoeL-A6IYGdIHBJGk9VVOCzjwzUgSdY-jK38hPdGYXVW8S0-O7-QJ_2ffJvp4ITCvqF-5jQXDgpk5DqFY4cUOomKo4XDOh_Orl-YO4W1eERfZX3eaG0xsc3L6oMr4Ufdmv-zH1q0V46skmTL3T5qEFd8HwjvSvOJMZ5J-GKf8E2YDAlp4gK9RWPNOmXsbpHogi0N3GMBFRJLNhnfon9kI-qg7vec3kr-g-X2O8nn",
