    {
      "id": "EX-0105",
      "category": "agility",
      "difficulty": "hard",
      "duration": 25,
      "learners": 12,
      "title": "Lệnh thu hồi khẩn cấp từ xa (Reliable Rocket Recall)",
      "desc": "Huấn luyện phản xạ quay đầu tức thì khi nghe lệnh còi hoặc từ khóa khẩn cấp, bất chấp mọi yếu tố xao nhãng như mèo chạy, xe cộ hay tiếng ồn.",
      "props": "Dây dài 10m + Thức ăn giá trị siêu cao (High Value Treat)",
      "propKeys": [
        "treat",
        "long-leash"
      ],
      "steps": [
        {
          "t": "Bước 1: Gắn từ khóa với thưởng lớn",
          "d": "Gọi tên + thổi còi, thưởng cực lớn ở khoảng cách 2m."
